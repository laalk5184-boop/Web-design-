rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny All Map
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitive Security Properties Definition
    function isSignedIn() { return request.auth != null; }
    
    // We'll consider any signed-in user as an admin to simplify for this single-user dashboard
    function isAdmin() { return isSignedIn(); }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 2. Blueprint Specific Validators
    function isValidLead(data) {
      return data.keys().hasAll(['name', 'email', 'createdAt', 'syncedToSheets']) &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.createdAt is timestamp &&
             data.syncedToSheets is bool &&
             (data.get('business', '') is string) &&
             (data.get('inquiryType', '') is string) &&
             (data.get('whatsapp', '') is string);
    }
    
    function isValidSetting(data) {
      return (data.keys().size() == 1 || data.keys().size() == 0) &&
             (!('spreadsheetId' in data) || (data.spreadsheetId is string && data.spreadsheetId.size() <= 200));
    }
    
    function isValidProject(data) {
      return data.keys().hasAll(['title']) && data.title is string && data.title.size() <= 200;
    }
    
    function isValidTestimonial(data) {
      return data.keys().hasAll(['name']) && data.name is string && data.name.size() <= 200;
    }
    
    function isValidPricingPlan(data) {
      return true; // Simplified for this zero-config dashboard
    }

    // 3. Collection Rules
    match /leads/{leadId} {
      allow read, delete: if isAdmin();
      
      allow create: if true;

      // When admin syncs, allow updating syncedToSheets
      allow update: if isAdmin() && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['syncedToSheets', 'updatedAt']) &&
                    incoming().syncedToSheets is bool;
    }

    match /settings/{settingId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidSetting(incoming());
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /pricing_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
